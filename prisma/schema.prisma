// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  DEVELOPER
  TESTER
  ADMIN
}

enum JobStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeveloperLeadStatus {
  NOT_CONTACTED
  CONTACTED
  REPLY_RECEIVED
  BOOKED_DEMO
  QUOTED
  PAID
}

enum DeveloperLeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum ApplicationStatus {
  PENDING
  APPROVED
  OPTED_IN
  VERIFIED
  SCHEDULED
  TESTING
  COMPLETED
  INELIGIBLE
  REJECTED
  WITHDRAWN
}

enum ApplicationIssueStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  INCOMPATIBLE
}

enum PaymentStatus {
  PENDING
  ESCROWED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum UsageEventType {
  APP_LAUNCH
  FEATURE_USED
  FEEDBACK_SUBMITTED
  SESSION_END
}
enum FeedbackCategory {
  PLATFORM
  JOB_COMPLETION
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hashed with bcrypt
  name          String?
  role          UserRole  @default(TESTER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Account Status
  suspended     Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?

  // Password reset
  passwordResetToken      String?
  passwordResetExpiresAt  DateTime?
  
  // Fraud Detection
  fraudScore    Int       @default(0)  // 0-100, higher = more suspicious
  flagged       Boolean   @default(false)
  lastIpAddress String?
  signupIp      String?
  
  // Developer fields
  stripeCustomerId String?  @unique
  developedJobs    TestingJob[]
  
  // Email verification tracking
  lastVerificationSentAt DateTime?
  
  // Activity tracking
  lastLoginAt            DateTime?
  lastActiveAt           DateTime?
  loginCount             Int       @default(0)
  
  // Tester fields
  stripeAccountId  String?  @unique
  muteDeveloperReplies Boolean @default(false)
  trainingPoints   Int      @default(0)
  trainingAwards   TrainingAward[]
  paypalEmail       String?
  phoneNumber      String?
  countryCode      String?
  applications     Application[]
  deviceInfo       DeviceInfo?
  
  // Notifications
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  fraudLogs         FraudLog[]
  feedbacks         Feedback[]
  feedbackReports   FeedbackReport[]
  usageLogs         AppUsageLog[] @relation("UsageLogs")
  checkIns          DailyCheckIn[] @relation("TesterCheckIns")
  taskSubmissions   TaskSubmission[]
  issueReports      ApplicationIssueReport[]
  conversationThreads ConversationThread[] @relation("ThreadTester")
  threadMessages    ThreadMessage[]
  jobGroupMemberships JobGroupMember[]
  jobGroupMessages  JobGroupMessage[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  communityReports  CommunityReport[]
  communityMute     CommunityMute?
  communityBlocksMade     CommunityBlock[] @relation("CommunityBlocker")
  communityBlocksReceived CommunityBlock[] @relation("CommunityBlocked")
  applicationPausesInitiated  ApplicationPause[] @relation("ApplicationPauseInitiator")
  applicationResumesInitiated ApplicationPause[] @relation("ApplicationPauseResumeInitiator")
  paymentAllocationActions PaymentAllocationHistory[]
  
  // Ratings
  averageRating    Float?   @default(0)
  totalRatings     Int?     @default(0)
  
  // Tester Reputation (cached for performance)
  averageEngagementScore Float?   @default(0)
  totalTestsCompleted    Int?     @default(0)
  totalEarnings          Int?     @default(0) // stored in cents
  
  // Developer features: Follow/Bookmark testers
  followedTesters FollowedTester[] @relation("DeveloperFollows")
  followedBy      FollowedTester[] @relation("TesterFollowedBy")
  
  // Developer features: Verify testers
  verifiedTesters VerifiedTester[] @relation("DeveloperVerifies")
  verifiedBy      VerifiedTester[] @relation("TesterVerifiedBy")
}

model DeveloperLead {
  id            String               @id @default(cuid())
  name          String
  email         String
  appName       String
  source        String?
  status        DeveloperLeadStatus  @default(NOT_CONTACTED)
  priority      DeveloperLeadPriority @default(MEDIUM)
  lastContacted DateTime?
  nextAction    String?              @db.Text
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model FollowedTester {
  id            String   @id @default(cuid())
  developerId   String
  developer     User     @relation("DeveloperFollows", fields: [developerId], references: [id], onDelete: Cascade)
  
  testerId      String
  tester        User     @relation("TesterFollowedBy", fields: [testerId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())

  @@unique([developerId, testerId])
  @@index([developerId])
  @@index([testerId])
}

model VerifiedTester {
  id            String   @id @default(cuid())
  developerId   String
  developer     User     @relation("DeveloperVerifies", fields: [developerId], references: [id], onDelete: Cascade)
  
  testerId      String
  tester        User     @relation("TesterVerifiedBy", fields: [testerId], references: [id], onDelete: Cascade)
  
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([developerId, testerId])
  @@index([developerId])
  @@index([testerId])
}

model DeviceInfo {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceModel    String
  androidVersion String
  screenSize     String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TestingJob {
  id                String      @id @default(cuid())
  developerId       String
  developer         User        @relation(fields: [developerId], references: [id])

  planType String? // 'STARTER' | 'GROWTH' | 'PRO' | 'TRAINING'

  // Admin-run training job: no payment, no payout, awards training points instead
  isTraining        Boolean     @default(false)
  
  // App Details
  appName           String
  appDescription    String      @db.Text
  packageName       String?
  googlePlayLink    String
  appCategory       String?
  
  // Requirements
  testersNeeded     Int         @default(12)
  testDuration      Int         @default(14)
  minAndroidVersion String?
  supportedCountries String[] @default([])
  
  // Compensation
  paymentPerTester  Int
  totalBudget       Int
  platformFee       Int
  
  // Payment tracking (for refunds)
  stripeSessionId   String?     @unique
  stripePaymentIntent String?   @unique

  // Email tracking
  testimonialEmailSent Boolean @default(false)
  
  // Status
  status            JobStatus   @default(DRAFT)
  publishedAt       DateTime?
  startedAt         DateTime?
  scheduledStartAt  DateTime?
  completedAt       DateTime?
  
  // Relations
  applications      Application[]
  payments          Payment[]
  paymentAllocationHistory PaymentAllocationHistory[]
  questionnaire     ProductionQuestionnaire?
  dailyTasks        DailyTask[]
  issueReports      ApplicationIssueReport[]
  conversationThreads ConversationThread[]
  groupMembers      JobGroupMember[]
  groupMessages     JobGroupMessage[]
  communityPost     CommunityPost?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([developerId])
  @@index([status])
}

model Application {
  id                String              @id @default(cuid())
  jobId             String
  job               TestingJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  testerId          String
  tester            User                @relation(fields: [testerId], references: [id])
  
  status            ApplicationStatus   @default(PENDING)
  cohortSelected    Boolean             @default(false)
  contactReleasedAt DateTime?
  screeningPassedAt DateTime?
  
  // Verification
  optInVerified     Boolean             @default(false)
  verificationImage String?
  verificationImage2 String?
  verifiedAt        DateTime?
  
  // Fraud Detection
  ipAddress         String?
  userAgent         String?
  
  // Testing Period
  testingStartDate  DateTime?
  testingEndDate    DateTime?
  testingPausedAt   DateTime?
  testingPausedDurationMs Float @default(0)
  
  // Feedback
  feedback          String?             @db.Text
  rating            Int?
  feedbackSubmittedAt DateTime?
  developerReply    String?             @db.Text
  developerReplyAt  DateTime?
  testerFollowupReply String?           @db.Text
  testerFollowupAt  DateTime?
  
  // Engagement tracking
  engagementScore   Int?                @default(0) // 0-100 score based on testing activity
  usageLogs         AppUsageLog[]
  dailyCheckIns     DailyCheckIn[]
  
  // Payment
  payment           Payment?
  feedbackReports   FeedbackReport[]
  feedbacks Feedback[]
  issueReports ApplicationIssueReport[]
  submissionVideos SubmissionVideo[]
  trainingAwards TrainingAward[]
  pauseHistory ApplicationPause[]
  paymentAllocationsFrom PaymentAllocationHistory[] @relation("PaymentAllocationFrom")
  paymentAllocationsTo PaymentAllocationHistory[] @relation("PaymentAllocationTo")
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@unique([jobId, testerId])
  @@index([jobId])
  @@index([testerId])
  @@index([status])
  @@index([ipAddress])
  
}

model TrainingAward {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String      // 'OPTED_IN' | 'VERIFIED' | 'COMPLETED'
  points        Int
  createdAt     DateTime    @default(now())

  @@unique([applicationId, kind])
  @@index([userId])
}

model ApplicationPause {
  id                    String      @id @default(cuid())
  applicationId         String
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  pausedAt              DateTime
  pauseReason           String      @db.Text
  pausedById            String
  pausedBy              User        @relation("ApplicationPauseInitiator", fields: [pausedById], references: [id])
  resumeScheduledAt     DateTime?
  resumeReason          String?     @db.Text
  resumeInitiatedById   String?
  resumeInitiatedBy     User?       @relation("ApplicationPauseResumeInitiator", fields: [resumeInitiatedById], references: [id])
  resumedAt             DateTime?
  createdAt             DateTime    @default(now())

  @@index([applicationId, resumedAt])
}

model ApplicationIssueReport {
  id            String                @id @default(cuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobId         String
  job           TestingJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  testerId      String
  tester        User                  @relation(fields: [testerId], references: [id], onDelete: Cascade)
  category      String
  details       String                @db.Text
  attachmentUrls String[]             @default([])
  conversationThread ConversationThread?
  status        ApplicationIssueStatus @default(OPEN)
  adminNote     String?               @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([applicationId, status])
  @@index([status, createdAt])
}

model FeedbackReport {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason        String
  details       String?     @db.Text
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?

  @@index([applicationId])
  @@index([reporterId])
}

model Payment {
  id                String        @id @default(cuid())
  applicationId     String        @unique
  application       Application   @relation(fields: [applicationId], references: [id])
  jobId             String
  job               TestingJob    @relation(fields: [jobId], references: [id])
  
  amount            Int
  platformFee       Int
  totalAmount       Int
  
  status            PaymentStatus @default(PENDING)
  
  // Stripe IDs
  paymentIntentId   String?       @unique
  transferId        String?       @unique

  // Timestamps
  escrowedAt        DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  allocationHistory PaymentAllocationHistory[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([status])
  @@index([jobId])
}

model PaymentAllocationHistory {
  id                String      @id @default(cuid())
  paymentId         String
  payment           Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  jobId             String
  job               TestingJob  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  fromApplicationId String
  fromApplication   Application @relation("PaymentAllocationFrom", fields: [fromApplicationId], references: [id], onDelete: Restrict)
  toApplicationId   String
  toApplication     Application @relation("PaymentAllocationTo", fields: [toApplicationId], references: [id], onDelete: Restrict)
  actorId           String
  actor             User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason            String      @db.Text
  createdAt         DateTime    @default(now())

  @@index([jobId, createdAt])
  @@index([paymentId, createdAt])
  @@index([fromApplicationId])
  @@index([toApplicationId])
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  endpoint    String   @unique
  p256dh      String
  auth        String
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  body        String
  url         String?
  type        String   // application_approved, testing_started, payment_received, etc.
  read        Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([read])
}

model FraudLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  type        String   // duplicate_ip, same_device, rapid_signup, suspicious_pattern, etc.
  severity    String   @default("low") // low, medium, high, critical
  description String   @db.Text
  metadata    String?  @db.Text // JSON data for additional context
  
  ipAddress   String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // Admin user id
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([ipAddress])
}

model Feedback {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Link to completed Application (nullable, survives Application deletion)
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  
  // Category classification
  category        FeedbackCategory @default(PLATFORM)  
  // Feedback details
  type            String    // 'developer' or 'tester'
  rating          Int       // 1-5 stars
  title           String
  message         String    @db.Text
  
  // Approval workflow
  approved        Boolean   @default(false)
  approvedAt      DateTime?
  approvedBy      String?   // Admin user id
  
  // Display settings
  displayName     String?   // Optional name to display (privacy)
  companyName     String?   // Optional company name
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([approved])
  @@index([type])
  @@index([rating])
  @@index([applicationId])
  @@index([category])
  }

model AppUsageLog {
  id              String    @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  testerId        String
  tester          User      @relation("UsageLogs", fields: [testerId], references: [id], onDelete: Cascade)
  
  // Usage tracking
  eventType       UsageEventType
  featureName     String?   // e.g., "Login", "Payment", "Settings" - if feature_used
  sessionDuration Int?      // Duration in seconds if session_end
  
  // Context
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime  @default(now())
  
  @@index([applicationId])
  @@index([testerId])
  @@index([eventType])
  @@index([createdAt])
}

model ProductionQuestionnaire {
  id              String    @id @default(cuid())
  jobId           String    @unique
  job             TestingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  developerId     String
  
  // Part 1: About your closed test
  recruiterEase   String?   // very_easy, easy, moderate, difficult, very_difficult
  engagementSummary String? @db.Text // How testers used features, consistency with expected usage
  feedbackSummary String?   @db.Text // Summary of feedback received and how it was collected
  
  // Part 2: About your app
  targetAudience  String?   @db.Text // Who is the intended audience
  valueProposition String?  @db.Text // How app provides value (apps) or what makes it stand out (games)
  expectedInstalls String? // first_year_installs range
  
  // Part 3: Production readiness
  changesApplied  String?   @db.Text // Changes made based on closed test feedback
  readinessCriteria String? @db.Text // How you decided app is ready for production
  
  submitted       Boolean   @default(false)
  submittedAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([developerId])
}

// Persist contact form submissions so admins can review and audit messages
model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String   @db.Text
  ipAddress   String?
  userId      String?  // optional if the sender is a registered user
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Daily check-ins from testers to developers during the 14-day testing period
model DailyCheckIn {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  testerId      String
  tester        User        @relation("TesterCheckIns", fields: [testerId], references: [id], onDelete: Cascade)

  // Day number in the testing period (1–14+)
  dayNumber     Int

  // What the tester did today
  message       String      @db.Text  // e.g. "Tested login flow, found a crash on Samsung Galaxy"
  usedApp       Boolean     @default(true)
  issuesFound   Boolean     @default(false)
  issueDetails  String?     @db.Text

  // Developer acknowledgement
  devAcknowledged   Boolean   @default(false)
  devAcknowledgedAt DateTime?
  devNote           String?   @db.Text  // optional short reply from dev

  createdAt     DateTime    @default(now())

  @@unique([applicationId, dayNumber]) // one check-in per day per application
  @@index([applicationId])
  @@index([testerId])
  @@index([createdAt])
}

model DailyTask {
  id          String      @id @default(cuid())
  jobId       String
  job         TestingJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dayNumber   Int
  taskText    String      @db.Text
  createdAt   DateTime    @default(now())
  submissions TaskSubmission[]

  @@unique([jobId, dayNumber])
  @@index([jobId])
}

model TaskSubmission {
  id            String    @id @default(cuid())
  taskId        String
  task          DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  testerId      String
  tester        User      @relation(fields: [testerId], references: [id], onDelete: Cascade)
  content       String    @db.Text
  screenshotUrl String?
  completedAt   DateTime  @default(now())
  conversationThread ConversationThread?
  video         SubmissionVideo?

  @@unique([taskId, testerId])
  @@index([taskId])
  @@index([testerId])
}

// Optional screen recording attached to a daily mission upload. The file is deleted 14 days after testing ends;
// this row stays (with deletedAt set) so the text record of the upload is never lost.
model SubmissionVideo {
  id               String         @id @default(cuid())
  taskSubmissionId String?        @unique
  taskSubmission   TaskSubmission? @relation(fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  applicationId    String
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  blobUrl          String
  blobPathname     String         @unique
  contentType      String
  sizeBytes        Int
  durationSeconds  Int
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?

  @@index([applicationId])
  @@index([deletedAt])
}

enum ThreadKind {
  ISSUE_REPORT
  MISSION_SUBMISSION
  ADMIN_MESSAGE
}

// One conversation per issue report, per mission submission, or per private tester-to-admin message.
model ConversationThread {
  id               String                  @id @default(cuid())
  kind             ThreadKind
  testerId         String
  tester           User                    @relation("ThreadTester", fields: [testerId], references: [id], onDelete: Cascade)
  // Null for private tester-to-admin messages, which no developer can see.
  jobId            String?
  job              TestingJob?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  issueReportId    String?                 @unique
  issueReport      ApplicationIssueReport? @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  taskSubmissionId String?                 @unique
  taskSubmission   TaskSubmission?         @relation(fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  subject          String
  lastMessageAt    DateTime                @default(now())
  createdAt        DateTime                @default(now())
  messages         ThreadMessage[]

  @@index([testerId, lastMessageAt])
  @@index([jobId, lastMessageAt])
  @@index([kind, lastMessageAt])
}

model ThreadMessage {
  id         String             @id @default(cuid())
  threadId   String
  thread     ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole String
  body       String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([threadId, createdAt])
  @@index([authorId])
}

// Group chat for one job. Separate from the private ConversationThread tables.
// Testers get a row only when they press Join; the developer and admins are members by rule, not by row.
model JobGroupMember {
  id       String     @id @default(cuid())
  jobId    String
  job      TestingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

model JobGroupMessage {
  id         String     @id @default(cuid())
  jobId      String
  job        TestingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole String
  body       String     @db.Text
  createdAt  DateTime   @default(now())

  @@index([jobId, createdAt])
  @@index([authorId])
}

enum CommunityPostKind {
  POST
  ANNOUNCEMENT
  JOB
}

enum CommunityContentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommunityReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// In-app community feed. Counts are stored on the post so the feed never has to count rows.
model CommunityPost {
  id             String                 @id @default(cuid())
  authorId       String
  author         User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind           CommunityPostKind      @default(POST)
  title          String?
  body           String                 @db.Text
  // Set only for automatic job posts; unique so a job can never be posted twice.
  jobId          String?                @unique
  job            TestingJob?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pinned         Boolean                @default(false)
  status         CommunityContentStatus @default(VISIBLE)
  likeCount      Int                    @default(0)
  commentCount   Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  comments       CommunityComment[]
  likes          CommunityLike[]
  reports        CommunityReport[]

  @@index([status, pinned, createdAt])
  @@index([kind, status, createdAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id        String                 @id @default(cuid())
  postId    String
  post      CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String                 @db.Text
  status    CommunityContentStatus @default(VISIBLE)
  createdAt DateTime               @default(now())
  reports   CommunityReport[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model CommunityLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// A report is about one post or one comment. Each person can report the same item only once.
model CommunityReport {
  id          String                @id @default(cuid())
  reporterId  String
  reporter    User                  @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId      String?
  post        CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason      String
  status      CommunityReportStatus @default(OPEN)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime              @default(now())

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
}

// A muted person can read the community but not write. Null mutedUntil means until an admin lifts it.
model CommunityMute {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutedById  String
  reason     String
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
}

// The blocker no longer sees the blocked person's posts and comments.
model CommunityBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("CommunityBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("CommunityBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model CommunityModerationLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Small cache table, for example the member count, so busy pages do not recount users.
model CommunityStat {
  key       String   @id
  value     Int
  updatedAt DateTime @default(now())
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorEmail String
  action    String
  targetType String
  targetId  String
  reason    String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

model CronExecution {
  id           String   @id @default(cuid())
  jobName      String
  status       String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  durationMs   Int?
  errorMessage String?  @db.Text

  @@index([jobName, startedAt])
}
